MOGOBE_DATABASE_URL=sqlite+aiosqlite:///./data/mogobe.sqlite3
MOGOBE_SERVER_NAME=Могоби
MOGOBE_SESSION_HOURS=24
MOGOBE_REMEMBERED_SESSION_DAYS=30
MOGOBE_REGISTRATION_MINUTES=30
# False for the packaged client's local HTTP gateway. True for direct HTTPS browser access.
MOGOBE_COOKIE_SECURE=false

# Create the default admin account and recovered admin shop at startup.
MOGOBE_BOOTSTRAP_DEFAULTS=true
